GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL_STRONG=gemini-flash-latest
# Optional: Groq (free, ~30 requests/minute) for text tasks — routing, phrasing and the agent loop.
# Voice and images always use Gemini.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_TEXT_PROVIDER=groq   # or gemini
# Optional: xAI (Grok voice) — reads answers aloud in Arabic and adds Grok speech-to-text.
# Without it the browser's own Arabic voice is used. Key from console.x.ai. Never commit it.
XAI_API_KEY=
# XAI_VOICE=ara
# XAI_TTS_LANG=ar-AE      # no Iraqi locale exists; Gulf (ar-AE) is closest to Basra speech. Also: ar-SA, ar-EG, auto
# Speech-to-text engines, tried in this order (only those with a key run):
# STT_ORDER=whisper,gemini,grok
# WHISPER_MODEL=whisper-large-v3   # runs on Groq with GROQ_API_KEY (verbose_json, temperature 0)
